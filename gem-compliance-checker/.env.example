# GeM Compliance Engine Environment Configuration

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
FASTAPI_ENDPOINT=http://localhost:8000/verify-bid

# Government Registry & API Setu Settings (https://apisetu.gov.in)
USE_APISETU=true
APISETU_CLIENT_ID=
APISETU_API_KEY=
APISETU_BASE_URL=https://apisetu.gov.in/certificate/v3
APISETU_TIMEOUT_SECONDS=4.0

# Mock Portals Fallback Data Path (relative to project root or absolute)
MOCK_REGISTRY_PATH=sample_data/mock_registry.json

# LLM Providers (Configure whichever provider is used for schema extraction)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_PROVIDER=gemini

# OCR Fallback Configuration (Set path if Tesseract binary is not on system PATH)
# TESSERACT_CMD_PATH=/usr/bin/tesseract
# TESSERACT_CMD_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
